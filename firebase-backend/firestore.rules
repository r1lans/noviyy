rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Staff role inside the admin panel (admins/{uid}.role): 'admin' (everything, the default for old records),
    // 'curator' (teacher control, groups, schedule, journal), 'content', 'finance'.
    // Things only a full admin may touch (who is staff) and money (pay, promo codes) are checked with this.
    function hasStaffRole(roles) {
      return isAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'admin') in roles;
    }

    // A teacher is an account whose profile has role == 'teacher'. Only an admin can give that role
    // (see the users rule below), so a student cannot make themselves a teacher.
    function ownsNick(nick) {
      return nick is string && existsAfter(/databases/$(database)/documents/nicknames/$(nick)) &&
        getAfter(/databases/$(database)/documents/nicknames/$(nick)).data.uid == request.auth.uid;
    }

    // TheStarth's own teachers. A TheStarth curator (users.role 'curator') is a teacher too.
    function isTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['teacher', 'curator'];
    }

    // A teacher of TheStarth OR an outside teacher who pays for the platform (role 'partner'):
    // both run their own groups and lessons. (Reading other students' results stays isTeacher() only.)
    function isTeacherOrPartner() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['teacher', 'partner', 'curator', 'partner_curator'];
    }
    // A partner teacher / partner curator may run lessons and open groups only while the paid period lasts (partnerUntil).
    function partnerActive() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return !(u.get('role', '') in ['partner', 'partner_curator']) || u.get('partnerUntil', 0) > request.time.toMillis();
    }
    // Today's date in Tashkent (UTC+5) as 'yyyy-mm-dd' — the only day a teacher may mark attendance himself.
    function tashkentToday() {
      let t = request.time + duration.value(5, 'h');
      return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month()) + '-' + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    // The curator a teacher works under (users/{uid}.curatorUid, set by TheStarth in Admin panel → «Ученики и роли»).
    function myCuratorUid() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('curatorUid', '');
    }
    function curatorOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('curatorUid', '');
    }
    // Partner curator (users/{uid}.role == 'partner_curator'): works in the admin panel, but only with THEIR teachers
    // (users whose curatorUid is this person) and the groups / lessons / marks that carry curatorUid == this person.
    // He is NOT in admins/, so everything else of TheStarth stays closed to him.
    function isPartnerCurator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'partner_curator';
    }
    // Curator roles are handed out only by a full admin.
    function curatorRoleChange() {
      return request.resource.data.get('role', 'student') != resource.data.get('role', 'student') &&
        (request.resource.data.get('role', 'student') in ['curator', 'partner_curator'] ||
         resource.data.get('role', 'student') in ['curator', 'partner_curator']);
    }

    // Each student can read/write only their own profile document.
    // Admins can read every profile, and can also write to any profile
    // (needed to change roles from the admin panel).
    // IMPORTANT: a person may edit their own profile but may NOT change their own role —
    // only an admin can make someone a teacher / admin (Admin panel -> Ученики).
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin() ||
        resource.data.get('curatorUid', '') == request.auth.uid);      // a partner curator sees their teachers
      // The nickname in a profile must be one this person really reserved (nicknames/{nick}.uid == uid),
      // otherwise someone could pose as another student (messenger, «Не смогу прийти» for someone else's lesson).
      allow create: if isSignedIn() && (isAdmin() || (request.auth.uid == uid &&
        request.resource.data.get('role', 'student') == 'student' &&
        (request.resource.data.get('nickname', '') == '' || ownsNick(request.resource.data.nickname))));
      allow update: if isSignedIn() && ((isAdmin() && (!curatorRoleChange() || hasStaffRole(['admin']))) || (request.auth.uid == uid &&
        request.resource.data.get('role', 'student') == resource.data.get('role', 'student') &&
        request.resource.data.get('curatorUid', '') == resource.data.get('curatorUid', '') &&
        // paid access and the partner organisation are set by TheStarth only (a teacher may only send an application)
        request.resource.data.get('partnerUntil', 0) == resource.data.get('partnerUntil', 0) &&
        request.resource.data.get('partnerId', '') == resource.data.get('partnerId', '') &&
        (request.resource.data.get('partnerStatus', '') == resource.data.get('partnerStatus', '') ||
         (request.resource.data.get('partnerStatus', '') == 'pending' && resource.data.get('partnerStatus', '') in ['', 'rejected'])) &&
        (request.resource.data.get('nickname', '') == resource.data.get('nickname', '') ||
         request.resource.data.get('nickname', '') == '' || ownsNick(request.resource.data.nickname))));
      allow delete: if isAdmin();
    }

    // Nickname uniqueness "reservation" documents: doc id == the nickname.
    // Read is public (not signed-in yet) because availability must be
    // checkable *before* the account exists — that's the whole point.
    // Creating one still requires being signed in as that exact uid.
    match /nicknames/{nickname} {
      allow get: if true;
      allow list: if isAdmin();          // the whole list of nicknames / uids is not downloadable
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // the owner may release / re-point their own nickname (profile editor); an admin may clean up
      allow update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Student ID counter (000001, 000002, ...). Any signed-in user may read it and
    // move it forward by exactly +1 (that is how a new student takes the next number).
    // Nobody can lower it, skip numbers, or delete it.
    match /counters/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && doc == 'students' && request.resource.data.last == 1;
      allow update: if isSignedIn() && doc == 'students' &&
        request.resource.data.last == resource.data.last + 1;
      allow delete: if false;
    }

    // News & reviews: public read of published items. Admins can write
    // anything; signed-in students can submit a review, but only ever
    // as unpublished (pending admin approval) — never publish themselves.
    match /news/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if resource.data.published == true || isAdmin();
      // Signed-in people can only send a review as "not published yet", with sane sizes (no anonymous spam).
      allow create: if isAdmin() || (isSignedIn() &&
        request.resource.data.published == false &&
        request.resource.data.keys().hasOnly(['name', 'rating', 'text', 'published', 'createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1500
      );
      allow update, delete: if isAdmin();
    }

    // Teachers shown in "О нас -> Команда Экспертов" and on teacher.html.
    // Everyone can read; only admins can add / edit / delete (Admin panel -> Учителя).
    match /teachers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student results (certificates with the magnifier) on results.html.
    // Everyone can read; only admins can add / delete (Admin panel -> Результаты).
    match /results/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Videos in the home-page carousel (Admin panel -> Видео).
    // Everyone can watch; only admins can add / reorder / delete.
    match /heroVideos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lesson schedule: admin assigns lessons (teacher + student + time).
    // Readable by signed-in people only (students and teachers load their own lessons); only admins write.
    match /schedule/{id} {
      allow read: if isSignedIn();       // not visible to the whole internet any more
      allow create: if isAdmin() || (isPartnerCurator() && request.resource.data.teacherUid is string &&
        curatorOf(request.resource.data.teacherUid) == request.auth.uid);
      allow delete: if isAdmin() || (isPartnerCurator() && curatorOf(resource.data.teacherUid) == request.auth.uid);
      // The assigned teacher may also update ONE lesson: mark it done/missed and
      // leave homework — nothing else (not the date, time, student, or teacher).
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.teacherUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'homework', 'note']) &&
        request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.studentNickname == resource.data.studentNickname &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.time == resource.data.time
      );
    }

    // Site-wide settings (accent color, logo, announcement banner):
    // public read, admin-only write.
    match /settings/{doc} {
      allow read: if doc != 'salary' || isAdmin() || isTeacher();   // pay rates — staff only
      allow write: if isAdmin();
    }

    // ── TEACHER CABINET ─────────────────────────────────────────────────────
    // The group's main teacher (teacherUid) or a second teacher the admin added (coTeacherUids).
    // Second teachers only LOOK (students, attendance, grades); only the main teacher writes.
    function isStaffOf(gid) {
      let g = get(/databases/$(database)/documents/groups/$(gid)).data;
      return g.teacherUid == request.auth.uid || request.auth.uid in g.get('coTeacherUids', []);
    }
    // Groups: a teacher creates and manages their own groups; a student can read the groups they are in.
    match /groups/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.get('curatorUid', '') == request.auth.uid ||
        resource.data.teacherUid == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid in resource.data.get('coTeacherUids', []));
      // format / priceOverride decide the teacher's pay, coTeacherUids who else sees the group — only an admin sets them.
      allow create: if isSignedIn() && (isAdmin() ||
        (isTeacherOrPartner() && partnerActive() && request.resource.data.teacherUid == request.auth.uid &&
         request.resource.data.get('curatorUid', '') == myCuratorUid() &&
         !('format' in request.resource.data) && !('priceOverride' in request.resource.data) &&
         !('coTeacherUids' in request.resource.data) && !('coTeachers' in request.resource.data)) ||
        // a partner curator creates groups for their own teachers
        (isPartnerCurator() && request.resource.data.curatorUid == request.auth.uid &&
         curatorOf(request.resource.data.teacherUid) == request.auth.uid &&
         !('format' in request.resource.data) && !('priceOverride' in request.resource.data)));
      allow update: if isSignedIn() && (isAdmin() ||
        (resource.data.teacherUid == request.auth.uid && request.resource.data.teacherUid == request.auth.uid &&
         request.resource.data.get('format', '') == resource.data.get('format', '') &&
         request.resource.data.get('priceOverride', 0) == resource.data.get('priceOverride', 0) &&
         request.resource.data.get('coTeacherUids', []) == resource.data.get('coTeacherUids', []) &&
         request.resource.data.get('coTeachers', []) == resource.data.get('coTeachers', []) &&
         request.resource.data.get('curatorUid', '') == resource.data.get('curatorUid', '')) ||
        (isPartnerCurator() && resource.data.get('curatorUid', '') == request.auth.uid &&
         request.resource.data.curatorUid == request.auth.uid &&
         curatorOf(request.resource.data.teacherUid) == request.auth.uid &&
         request.resource.data.get('format', '') == resource.data.get('format', '') &&
         request.resource.data.get('priceOverride', 0) == resource.data.get('priceOverride', 0)));
      allow delete: if isSignedIn() && (isAdmin() || resource.data.teacherUid == request.auth.uid ||
        (isPartnerCurator() && resource.data.get('curatorUid', '') == request.auth.uid));
    }

    // Attendance: one document per group per day, id = "<groupId>_<yyyy-mm-dd>" — a school-style journal.
    //   teacher of the group: ONLY today's lesson (Tashkent date). Past and future days are closed to him.
    //   curator (admin / Куратор TheStarth, or the partner curator of this group): any day.
    // The record always carries the group's teacher in teacherUid (pay is counted from it), whoever wrote it.
    function groupOf(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data;
    }
    match /attendance/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.get('curatorUid', '') == request.auth.uid ||
        resource.data.teacherUid == request.auth.uid ||
        request.auth.uid in resource.data.studentUids ||
        isStaffOf(resource.data.groupId));
      allow create, update: if isSignedIn() &&
        id == request.resource.data.groupId + '_' + request.resource.data.date &&
        request.resource.data.teacherUid == groupOf(request.resource.data.groupId).teacherUid &&
        request.resource.data.get('curatorUid', '') in ['', groupOf(request.resource.data.groupId).get('curatorUid', '')] && (
          hasStaffRole(['admin', 'curator']) ||
          (isPartnerCurator() && groupOf(request.resource.data.groupId).get('curatorUid', '') == request.auth.uid) ||
          (isTeacherOrPartner() && request.resource.data.teacherUid == request.auth.uid &&
           request.resource.data.date == tashkentToday()));
      allow delete: if isSignedIn() && (hasStaffRole(['admin', 'curator']) ||
        (isPartnerCurator() && resource.data.get('curatorUid', '') == request.auth.uid) ||
        (resource.data.teacherUid == request.auth.uid &&
         (resource.data.date == tashkentToday() || !existsAfter(/databases/$(database)/documents/groups/$(resource.data.groupId)))));
    }

    // Grades (0-10): written by the group's teacher; readable by that teacher and by the graded student.
    match /grades/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.get('curatorUid', '') == request.auth.uid ||
        resource.data.teacherUid == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        isStaffOf(resource.data.groupId));
      allow create: if isSignedIn() && (isAdmin() || (
        isTeacherOrPartner() &&
        request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.get('curatorUid', '') in ['', get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.get('curatorUid', '')] &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 && request.resource.data.score <= 10 &&
        get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.teacherUid == request.auth.uid));
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (isAdmin() || resource.data.teacherUid == request.auth.uid ||
        (isPartnerCurator() && resource.data.get('curatorUid', '') == request.auth.uid));
    }

    // Lesson whiteboard. Every teacher (teacher / partner / curator) and every admin is a "host" of any board:
    // draws, gives / takes drawing rights, clears it. teacherUid is only the lead teacher (a teacher may take
    // the lead over, nobody can hand it to someone else). Students draw only when a host allows them.
    function boardDoc(room) {
      return get(/databases/$(database)/documents/lessonBoards/$(room)).data;
    }
    function boardHost(room) {
      return isSignedIn() && (boardDoc(room).teacherUid == request.auth.uid || isTeacherOrPartner() || isAdmin());
    }
    function boardWriter(room) {
      return isSignedIn() && (boardDoc(room).get('allowAll', false) == true ||
        request.auth.uid in boardDoc(room).get('allowed', []) || boardHost(room));
    }

    match /lessonBoards/{room} {
      allow read: if true;
      allow create: if isSignedIn() && (isTeacherOrPartner() || isAdmin()) && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() &&
        (resource.data.teacherUid == request.auth.uid || isTeacherOrPartner()) &&
        (request.resource.data.teacherUid == resource.data.teacherUid || request.resource.data.teacherUid == request.auth.uid));
      allow delete: if isAdmin();

      match /strokes/{strokeId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.pts.size() >= 2 && request.resource.data.pts.size() <= 400 &&
          (!('text' in request.resource.data) || request.resource.data.text.size() <= 300) &&
          boardWriter(room);
        // Text can be edited / moved by its author or by any host (while they still may write).
        allow update: if isSignedIn() && ('text' in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pts', 'text', 'ts']) &&
          request.resource.data.pts.size() == 2 && request.resource.data.text.size() <= 300 &&
          (resource.data.uid == request.auth.uid || boardHost(room)) &&
          boardWriter(room);
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || boardHost(room));
      }

      // "Who is in the room" — each signed-in person writes only their own entry.
      match /people/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Group leaderboard privacy: a student can hide themselves from the rating (hidden: true).
    // Group mates read it to know whom to leave out. Each person writes only their own document.
    match /boardPrefs/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['hidden', 'updatedAt']) && request.resource.data.hidden is bool;
      allow delete: if false;
    }

    // ── DIRECTORY: a public "phone book" (name, nickname, role) so signed-in people can find each other in the messenger.
    // Nothing else from the profile is exposed. A person writes only their own entry and it must match their profile.
    match /directory/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isAdmin() || (request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        request.resource.data.nickname == get(/databases/$(database)/documents/users/$(uid)).data.get('nickname', '') &&
        request.resource.data.role == (get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'student') in ['teacher', 'partner', 'curator', 'partner_curator'] ? 'teacher' : 'student')));
      allow delete: if isAdmin();
    }

    // ── MESSENGER (personal cabinet) ────────────────────────────────────────
    // chats/<uidA_uidB> — a private chat between exactly two people (uids sorted, joined with "_").
    // chats/<autoId> with group:true — a group (2..50 members). Only the creator can add/remove people or rename it;
    // any member can leave. Members read and write messages; a message author can edit/delete their own message
    // (the group creator can also delete messages in the group). Pinned message = field "pinned" on the chat doc.
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members && (
        (!('group' in request.resource.data) &&
          request.resource.data.members.size() == 2 &&
          chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1] &&
          request.resource.data.members[0] < request.resource.data.members[1]) ||
        (request.resource.data.group == true &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 50 &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60));
      allow update: if isSignedIn() && request.auth.uid in resource.data.members && (
        request.resource.data.members == resource.data.members ||
        (resource.data.get('group', false) == true && request.resource.data.group == true &&
          request.resource.data.createdBy == resource.data.createdBy &&
          ((resource.data.createdBy == request.auth.uid &&
              request.resource.data.members.size() >= 1 && request.resource.data.members.size() <= 50 &&
              request.auth.uid in request.resource.data.members) ||
           (request.resource.data.members.size() == resource.data.members.size() - 1 &&
              request.resource.data.members.hasAll(resource.data.members.removeAll([request.auth.uid]))))));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.get('group', false) == true && resource.data.createdBy == request.auth.uid);

      match /messages/{mid} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
          (!('img' in request.resource.data) ||
            (request.resource.data.img is string && request.resource.data.img.size() <= 260000 &&
             request.resource.data.img.matches('data:image/(jpeg|png|webp);base64,.*'))) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        // edit: only the author, only the text (plus the "edited" marks)
        allow update: if isSignedIn() && resource.data.from == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt']) &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow delete: if isSignedIn() && (resource.data.from == request.auth.uid || isAdmin() ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.get('group', false) == true &&
           get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid));
      }
    }

    // ── LIVE VIDEO LESSON (built-in call, lesson-call.js) ───────────────────
    // The room document holds teacher controls (mute everyone, remove a person) — only teachers/admins write it.
    // peers/ = who is in the room (each person writes only their own entry). signals/ = WebRTC handshake messages,
    // readable only by the addressee. chat/ = lesson chat.
    match /lessonCalls/{room} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isTeacherOrPartner();
      allow delete: if isAdmin();

      match /peers/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
      match /signals/{id} {
        allow read: if isSignedIn() && resource.data.to == request.auth.uid;
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid &&
          request.resource.data.data is string && request.resource.data.data.size() < 30000;
        allow delete: if isSignedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
      match /chat/{id} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() <= 500;
        allow delete: if isAdmin() || isTeacherOrPartner();
      }
    }

    // ── LESSON SESSIONS (who taught, when, for how long, who attended and for how many minutes) ──
    // Created by the teacher when they enter the room; closed with "Закончить урок". Everybody in the lesson writes ONLY
    // their own attendee entry (minutes spent). Readable by the teacher of that lesson and by admins.
    match /lessonSessions/{sid} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.teacherUid == request.auth.uid ||
        resource.data.get('curatorUid', '') == request.auth.uid);
      allow create: if isSignedIn() && isTeacherOrPartner() && partnerActive() && request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.get('curatorUid', '') in ['', myCuratorUid()];
      allow update: if isSignedIn() && (isAdmin() || resource.data.teacherUid == request.auth.uid);
      allow delete: if isAdmin();

      match /attendees/{uid} {
        allow read: if isSignedIn() && (uid == request.auth.uid || isAdmin() ||
          get(/databases/$(database)/documents/lessonSessions/$(sid)).data.teacherUid == request.auth.uid ||
          get(/databases/$(database)/documents/lessonSessions/$(sid)).data.get('curatorUid', '') == request.auth.uid);
        allow create, update: if isSignedIn() && uid == request.auth.uid &&
          exists(/databases/$(database)/documents/lessonSessions/$(sid));
        allow delete: if isAdmin();
      }
    }

    // ── REFERRALS ───────────────────────────────────────────────────────────
    // referrals/<new student's uid>. A new student creates it once, as "registered", pointing at the
    // person who invited them (the nickname must really belong to referrerUid). Only admins can move
    // it to "paid" / "rewarded". Readable by the inviter, the invited student and admins.
    match /referrals/{id} {
      allow read: if isSignedIn() && (isAdmin() ||
        resource.data.referrerUid == request.auth.uid ||
        resource.data.referredUid == request.auth.uid);
      allow create: if isSignedIn() &&
        id == request.auth.uid &&
        request.resource.data.referredUid == request.auth.uid &&
        request.resource.data.status == 'registered' &&
        request.resource.data.referrerUid != request.auth.uid &&
        request.resource.data.keys().hasOnly(['referrerUid', 'referrerNickname', 'referredUid', 'referredNickname', 'referredName', 'status', 'createdAt']) &&
        get(/databases/$(database)/documents/nicknames/$(request.resource.data.referrerNickname)).data.uid == request.resource.data.referrerUid;
      allow update, delete: if isAdmin();
    }

    // IELTS mock tests (Admin panel -> Mock-тесты). Students read published tests only; admins write.
    match /mockTests/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // What a student got on a mock test. A student can only add a result under their own uid
    // (and read their own); admins and teachers read everything; only admins can edit or delete.
    match /mockResults/{id} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'testId', 'title', 'skill', 'scope', 'parts', 'correct', 'total', 'band', 'bandEstimated', 'secs', 'ts', 'fullId', 'fullTitle']) &&
        request.resource.data.skill in ['listening', 'reading'] &&
        request.resource.data.scope in ['full', 'part'] &&
        request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
        request.resource.data.title is string && request.resource.data.title.size() <= 120 &&
        request.resource.data.correct is int && request.resource.data.total is int &&
        request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.total &&
        request.resource.data.total <= 40 &&
        request.resource.data.parts is list && request.resource.data.parts.size() <= 4;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin() || isTeacher());
      allow update, delete: if isAdmin();
    }

    // IELTS Speaking with AI (speaking.html). A student saves their own result (the AI marks it, the page saves it);
    // the student reads their own, teachers and admins read all; only admins edit or delete.
    match /speakingResults/{id} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'topic', 'overall', 'fc', 'lr', 'gra', 'pr', 'words', 'wpm', 'secs',
          'summary', 'strengths', 'improve', 'mistakes', 'vocab', 'sample', 'parts', 'transcript', 'ts']) &&
        request.resource.data.kind in ['exam', 'practice'] &&
        request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
        request.resource.data.topic is string && request.resource.data.topic.size() <= 120 &&
        request.resource.data.overall is number && request.resource.data.overall >= 0 && request.resource.data.overall <= 9 &&
        request.resource.data.summary is string && request.resource.data.summary.size() <= 700 &&
        request.resource.data.transcript is list && request.resource.data.transcript.size() <= 120 &&
        request.resource.data.mistakes is list && request.resource.data.mistakes.size() <= 8 &&
        request.resource.data.vocab is list && request.resource.data.vocab.size() <= 6;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin() || isTeacher());
      allow update, delete: if isAdmin();
    }

    // AI Support Teacher mini-tests (ai-teacher.html). The student saves their own score (the page marks the test);
    // the student reads their own, teachers and admins read all; only admins edit or delete.
    match /tutorQuizzes/{id} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'nickname', 'subject', 'topic', 'score', 'total', 'wrong', 'ts']) &&
        request.resource.data.subject in ['english', 'ielts', 'sat', 'math', 'other'] &&
        request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
        request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40 &&
        request.resource.data.topic is string && request.resource.data.topic.size() <= 140 &&
        request.resource.data.total is int && request.resource.data.total >= 1 && request.resource.data.total <= 10 &&
        request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total &&
        request.resource.data.wrong is list && request.resource.data.wrong.size() <= 8;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin() || isTeacher());
      allow update, delete: if isAdmin();
    }

    // Writing work written on the site. A student adds their own work (always as 'new') and reads their own;
    // teachers and admins read all and add the evaluation (only the feedback fields can change); only admins delete.
    match /mockWritings/{id} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'testId', 'testTitle', 'taskIdx', 'taskTitle', 'taskType', 'prompt', 'imageUrl', 'text', 'words', 'secs', 'ts', 'status', 'fullId', 'fullTitle']) &&
        request.resource.data.status == 'new' &&
        request.resource.data.taskType in ['task1', 'task2'] &&
        request.resource.data.text is string && request.resource.data.text.size() <= 9500 &&
        request.resource.data.prompt is string && request.resource.data.prompt.size() <= 3100 &&
        request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin() || isTeacher());
      allow update: if (isAdmin() || isTeacher()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'status', 'checkedBy', 'checkedAt']);
      allow delete: if isAdmin();
    }

    // «Не смогу прийти»: a student warns the teacher about missing a lesson (site or Telegram bot).
    // Excused (= the lesson is not paid to the teacher) only when the notice is made at least 24 h before the lesson —
    // checked here against the server clock, so it cannot be faked. The Telegram worker writes with a service account.
    match /absences/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid || resource.data.teacherUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'nickname', 'name', 'groupId', 'scheduleId', 'teacherUid', 'date', 'dateNum', 'time', 'lessonAt', 'title', 'reason', 'excused', 'createdAt', 'via']) &&
        request.resource.data.via == 'site' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.lessonAt is timestamp &&
        request.resource.data.lessonAt > request.time &&
        request.resource.data.lessonAt < request.time + duration.value(60, 'd') &&
        request.resource.data.excused == (request.resource.data.lessonAt >= request.time + duration.value(24, 'h')) &&
        request.resource.data.dateNum == (request.resource.data.lessonAt + duration.value(5, 'h')).year() * 10000 + (request.resource.data.lessonAt + duration.value(5, 'h')).month() * 100 + (request.resource.data.lessonAt + duration.value(5, 'h')).day() &&
        request.resource.data.reason is string && request.resource.data.reason.size() <= 200 &&
        (
          (request.resource.data.groupId is string && request.resource.data.groupId != '' &&
           request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberUids &&
           request.resource.data.teacherUid == get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.teacherUid &&
           id == request.resource.data.groupId + '_' + request.resource.data.date + '_' + request.auth.uid)
          ||
          (request.resource.data.scheduleId is string && request.resource.data.scheduleId != '' &&
           get(/databases/$(database)/documents/schedule/$(request.resource.data.scheduleId)).data.studentNickname == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname &&
           request.resource.data.teacherUid == get(/databases/$(database)/documents/schedule/$(request.resource.data.scheduleId)).data.teacherUid &&
           id == 's_' + request.resource.data.scheduleId + '_' + request.resource.data.date + '_' + request.auth.uid)
        );
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (isAdmin() || (resource.data.uid == request.auth.uid && resource.data.lessonAt > request.time));
    }

    // ── ONLINE OLYMPIAD (Admin panel → «Олимпиада», page olympiad.html) ─────────────────────
    // olympiads/{id}: public once the admin confirmed and published it (questions WITHOUT answers).
    // olympiadKeys/{id}: the answer key — only admins ever read it; participants are marked in the admin panel.
    // olympiadAttempts/{oid_uid}: one attempt per person; the timer starts at the server time of creation, answers can be
    // saved while it runs (+2 min grace) and handed in once; scores / places are written by the admin.
    match /olympiads/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if hasStaffRole(['admin']);
    }
    // olympiadRegs/{oid_uid}: registration before the start (region, district, school, class). A person writes only
    // their own, while the olympiad is published and not over; admins read all (protocol, numbers by region).
    match /olympiadRegs/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        id == request.resource.data.oid + '_' + request.auth.uid &&
        request.resource.data.keys().hasOnly(['oid', 'uid', 'name', 'nickname', 'region', 'district', 'school', 'grade', 'at']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
        request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40 &&
        request.resource.data.region is string && request.resource.data.region.size() > 0 && request.resource.data.region.size() <= 40 &&
        request.resource.data.district is string && request.resource.data.district.size() > 0 && request.resource.data.district.size() <= 60 &&
        request.resource.data.school is string && request.resource.data.school.size() > 0 && request.resource.data.school.size() <= 80 &&
        request.resource.data.grade is string && request.resource.data.grade.size() > 0 && request.resource.data.grade.size() <= 10 &&
        request.resource.data.at == request.time &&
        get(/databases/$(database)/documents/olympiads/$(request.resource.data.oid)).data.published == true &&
        request.time.toMillis() <= get(/databases/$(database)/documents/olympiads/$(request.resource.data.oid)).data.endAt;
      allow delete: if hasStaffRole(['admin']);
    }
    match /olympiadKeys/{id} {
      allow read, write: if hasStaffRole(['admin']);
    }
    match /olympiadAttempts/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        id == request.resource.data.oid + '_' + request.auth.uid &&
        request.resource.data.keys().hasOnly(['oid', 'uid', 'name', 'nickname', 'startedAt', 'status', 'answers', 'leaves', 'region', 'district', 'school', 'grade']) &&
        request.resource.data.get('region', '') is string && request.resource.data.get('region', '').size() <= 40 &&
        request.resource.data.get('district', '') is string && request.resource.data.get('district', '').size() <= 60 &&
        request.resource.data.get('school', '') is string && request.resource.data.get('school', '').size() <= 80 &&
        request.resource.data.get('grade', '') is string && request.resource.data.get('grade', '').size() <= 10 &&
        request.resource.data.status == 'started' &&
        request.resource.data.startedAt == request.time &&
        request.resource.data.answers is map && request.resource.data.answers.size() == 0 &&
        request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
        request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40 &&
        get(/databases/$(database)/documents/olympiads/$(request.resource.data.oid)).data.published == true &&
        request.time.toMillis() >= get(/databases/$(database)/documents/olympiads/$(request.resource.data.oid)).data.startAt &&
        request.time.toMillis() <= get(/databases/$(database)/documents/olympiads/$(request.resource.data.oid)).data.endAt;
      allow update: if hasStaffRole(['admin']) || (isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        resource.data.status == 'started' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'leaves', 'status', 'submittedAt']) &&
        request.resource.data.status in ['started', 'submitted'] &&
        (request.resource.data.status == 'started' || request.resource.data.submittedAt == request.time) &&
        request.resource.data.answers is map && request.resource.data.answers.size() <= 300 &&
        request.time < resource.data.startedAt +
          duration.value(get(/databases/$(database)/documents/olympiads/$(resource.data.oid)).data.durationMin + 2, 'm'));
      allow delete: if hasStaffRole(['admin']);
    }

    // Teacher pay: bonuses / fines and «paid» marks. The teacher reads their own; only an admin writes.
    match /salaryAdjust/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.teacherUid == request.auth.uid);
      allow write: if hasStaffRole(['admin', 'finance']);
    }
    match /payouts/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.teacherUid == request.auth.uid);
      allow write: if hasStaffRole(['admin', 'finance']);
    }

    // Partner organisations (Admin panel → «Партнёры» → «Создать партнёра»): name, curator, teachers, paid period.
    // The partner curator reads his own organisation; only a full admin creates and changes them.
    match /partners/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.curatorUid == request.auth.uid);
      allow write: if hasStaffRole(['admin']);
    }

    // Curator's notes to a teacher (Admin panel → «Контроль учителей»): note / warning / thanks.
    // Staff write them; the teacher reads their own and may only mark them as read (readAt).
    match /curatorNotes/{id} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.teacherUid == request.auth.uid ||
        resource.data.get('curatorUid', '') == request.auth.uid);
      allow create: if (isAdmin() || (isPartnerCurator() && request.resource.data.curatorUid == request.auth.uid &&
          curatorOf(request.resource.data.teacherUid) == request.auth.uid)) &&
        request.resource.data.keys().hasOnly(['teacherUid', 'teacherName', 'kind', 'text', 'byUid', 'byName', 'ts', 'readAt', 'curatorUid']) &&
        request.resource.data.byUid == request.auth.uid &&
        request.resource.data.kind in ['note', 'warn', 'praise'] &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      allow update: if isAdmin() || (isSignedIn() &&
        resource.data.teacherUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']));
      allow delete: if isAdmin() || (isPartnerCurator() && resource.data.get('curatorUid', '') == request.auth.uid);
    }

    // Admin allowlist: existing admins can promote/demote other admins
    // from the admin panel. The very first admin still has to be added
    // by hand in the Firebase console (see FIREBASE_SETUP.md, step 6) —
    // there has to be one admin before any admin-granted permission works.
    // Admins are secret: a person can read only their own record; admins can read all. Only an admin writes.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if hasStaffRole(['admin']);      // a curator / content / finance person cannot hand out access (or raise their own)
    }

    // ── PRESENCE (online / in a lesson). Heartbeat document, one per person.
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Promo codes (Admin panel -> «Промокоды»): % discount or fully-free, with an optional expiry date.
    // Public read so the pricing block and the payment page can check a code; only an admin can write.
    match /promoCodes/{code} {
      allow get: if true;                // a typed code can be checked…
      allow list: if isAdmin();          // …but the list of all codes is not downloadable
      allow write: if hasStaffRole(['admin', 'finance']);
    }
  }
}
